@startuml
!pragma max_image_size 8192
skinparam nodesep 80
skinparam ranksep 45
skinparam conditionStyle inside
skinparam roundCorner 12
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam dpi 200

skinparam activity {
  StartColor #000000
  EndColor #000000
  BackgroundColor #FCF0CC
  BorderColor #B85450
  BorderThickness 1.2
  FontColor #000000
}
skinparam diamond {
  BackgroundColor #FCF0CC
  BorderColor #B85450
  BorderThickness 1.2
  FontColor #000000
  FontSize 10
}
skinparam arrow {
  Color #333333
  FontColor #000000
  FontSize 10
}

start
:Giao diện Chọn dịch vụ bắp nước (F&B);
if (Khách có nhu cầu bắp nước?) then ([Có nhu cầu])
  :Hiển thị thực đơn Combo bắp nước và giá niêm yết;
  :Chọn loại combo và số lượng mong muốn;
  :Cộng dồn combo vào đơn đặt vé;
  :Chuyển sang màn hình Xác nhận và Thanh toán;
else ([Bỏ qua])
  :Bỏ qua bước chọn dịch vụ bắp nước;
  :Chuyển sang màn hình Xác nhận và Thanh toán;
endif
stop
@enduml
