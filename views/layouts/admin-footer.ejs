            </div> <!-- End .admin-content -->
        </div> <!-- End .admin-main -->
    </div> <!-- End .admin-wrapper -->

    <!-- Container Thông Báo Real-time Toàn Cục cho Admin & Manager -->
    <div id="globalNotifToastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1090; margin-top: 64px; max-width: 390px; width: 100%;"></div>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <% if (typeof currentUser !== 'undefined' && currentUser && (currentUser.role_name === 'admin' || currentUser.role_name === 'manager')) { %>
    <script>
    (function initGlobalApprovalNotifications() {
        const APPROVAL_URL = '<%= currentUser.role_name === "manager" ? "/manager/approvals" : "/admin/approvals" %>';
        const BASE_DOC_TITLE = document.title;
        let notifSoundEnabled = localStorage.getItem('cinestarNotifSound') !== '0';
        let lastPendingIds = new Set();
        let initializedPending = false;

        function escHtml(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function fmtTimeShort(val) {
            if (!val) return '';
            const d = new Date(val);
            if (isNaN(d.getTime())) return String(val);
            const pad = n => String(n).padStart(2, '0');
            return `${pad(d.getHours())}:${pad(d.getMinutes())} ${pad(d.getDate())}/${pad(d.getMonth() + 1)}`;
        }

        function updateSoundIcon() {
            const btn = document.getElementById('btnToggleNotifSound');
            if (!btn) return;
            btn.innerHTML = notifSoundEnabled
                ? '<i class="fa-solid fa-volume-high text-danger"></i>'
                : '<i class="fa-solid fa-volume-xmark text-muted"></i>';
        }
        updateSoundIcon();

        window.toggleNotifSound = function() {
            notifSoundEnabled = !notifSoundEnabled;
            localStorage.setItem('cinestarNotifSound', notifSoundEnabled ? '1' : '0');
            updateSoundIcon();
        };

        function playNotifChime() {
            if (!notifSoundEnabled) return;
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                const ctx = new AudioCtx();
                const notes = [880, 1174.66];
                notes.forEach((freq, idx) => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.value = freq;
                    gain.gain.setValueAtTime(0.001, ctx.currentTime + idx * 0.12);
                    gain.gain.exponentialRampToValueAtTime(0.12, ctx.currentTime + idx * 0.12 + 0.02);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + idx * 0.12 + 0.25);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start(ctx.currentTime + idx * 0.12);
                    osc.stop(ctx.currentTime + idx * 0.12 + 0.26);
                });
            } catch (e) {}
        }

        function ringBell() {
            const bell = document.getElementById('topbarNotifBellIcon');
            if (!bell) return;
            bell.classList.remove('bell-ringing');
            void bell.offsetWidth;
            bell.classList.add('bell-ringing');
        }

        function syncPendingBadges(pendingCount) {
            const count = Math.max(0, Number(pendingCount || 0));

            const topBadge = document.getElementById('topbarNotifBadge');
            if (topBadge) {
                topBadge.innerText = count;
                topBadge.classList.toggle('d-none', count <= 0);
            }

            const sideBadge = document.getElementById('sidebarPendingBadge');
            if (sideBadge) {
                sideBadge.innerText = count;
                sideBadge.classList.toggle('d-none', count <= 0);
            }

            const dropCount = document.getElementById('notifDropdownCount');
            if (dropCount) dropCount.innerText = count;

            const banner = document.getElementById('globalPendingBanner');
            const bannerCnt = document.getElementById('globalPendingBannerCount');
            if (bannerCnt) bannerCnt.innerText = count;
            if (banner) banner.classList.toggle('d-none', count <= 0);

            document.title = count > 0 ? `(${count} vé chờ duyệt) ${BASE_DOC_TITLE}` : BASE_DOC_TITLE;
        }

        function showPendingOrderToast(order) {
            const container = document.getElementById('globalNotifToastContainer');
            if (!container) return;

            const amtStr = Number(order.total_amount || 0).toLocaleString('vi-VN');
            const code = order.bookingCode || order.booking_code || '';
            const id = Number(order.bookingId || order.id || 0);
            const customer = order.customer_name || 'Khách hàng';
            const payLabel = order.payment_method_label || order.payment_method || 'Chuyển khoản';

            const el = document.createElement('div');
            el.className = 'toast show bg-white border border-warning shadow-lg rounded-4 mb-2 overflow-hidden';
            el.setAttribute('role', 'alert');
            el.innerHTML = `
                <div class="toast-header bg-warning-subtle text-dark border-bottom border-warning py-2">
                    <i class="fa-solid fa-bell text-danger me-2"></i>
                    <strong class="me-auto small">Có vé mới cần duyệt!</strong>
                    <small class="text-muted">Vừa xong</small>
                    <button type="button" class="btn-close ms-2" onclick="this.closest('.toast').remove()"></button>
                </div>
                <div class="toast-body p-3 small">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <code class="text-primary fw-bold">${escHtml(code)}</code>
                        <strong class="text-danger">${amtStr} đ</strong>
                    </div>
                    <div class="text-dark mb-1"><strong>${escHtml(customer)}</strong> • ${escHtml(payLabel)}</div>
                    <div class="d-flex gap-2 mt-2">
                        ${id > 0 ? `<button type="button" class="btn btn-success text-white btn-sm flex-grow-1 fw-bold" onclick="window.quickApproveOrder(${id}, '${escHtml(code)}', '${escHtml(amtStr)}', this)"><i class="fa-solid fa-check-double me-1"></i>Đã nhận tiền</button>` : ''}
                        <a href="${APPROVAL_URL}" class="btn btn-outline-danger btn-sm fw-semibold">Xem đơn</a>
                    </div>
                </div>
            `;
            container.prepend(el);
            setTimeout(() => {
                if (el && el.parentNode) el.remove();
            }, 12000);
        }

        window.quickApproveOrder = async function(bookingId, bookingCode, amtStr, btn) {
            if (!confirm(`Xác nhận đã nhận đủ ${amtStr} đ cho đơn ${bookingCode}?`)) return;
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i>Đang duyệt...';
            }
            try {
                const res = await fetch(`/admin/bookings/${bookingId}/confirm-payment`, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                });
                const data = await res.json();
                if (data.success) {
                    const toastParent = btn && btn.closest('.toast');
                    if (toastParent) toastParent.remove();
                    if (data.counts) syncPendingBadges(data.counts.pending);
                    await window.loadPendingNotifications(false);
                    window.dispatchEvent(new CustomEvent('cinestar:booking-change', {
                        detail: { type: 'confirmed', bookingId, bookingCode }
                    }));
                } else {
                    alert(data.message || 'Không thể duyệt đơn!');
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fa-solid fa-check-double me-1"></i>Đã nhận tiền';
                    }
                }
            } catch (e) {
                alert('Lỗi kết nối khi duyệt đơn!');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-check-double me-1"></i>Đã nhận tiền';
                }
            }
        };

        window.loadPendingNotifications = async function(notifyNew = false) {
            try {
                const res = await fetch('/admin/api/bookings?status=pending', {
                    headers: { 'Accept': 'application/json' },
                    cache: 'no-store'
                });
                if (!res.ok) return;
                const data = await res.json();
                if (!data.success) return;

                const pendingList = data.bookings || [];
                const pendingCount = data.counts ? data.counts.pending : pendingList.length;
                syncPendingBadges(pendingCount);

                // Phát hiện đơn mới nếu polling bắt được
                if (initializedPending && notifyNew) {
                    pendingList.forEach(b => {
                        if (!lastPendingIds.has(Number(b.id))) {
                            ringBell();
                            playNotifChime();
                            showPendingOrderToast(b);
                        }
                    });
                }
                lastPendingIds = new Set(pendingList.map(b => Number(b.id)));
                initializedPending = true;

                const listEl = document.getElementById('notifDropdownList');
                if (!listEl) return;

                if (pendingList.length === 0) {
                    listEl.innerHTML = `
                        <div class="text-center text-muted small py-4 px-3">
                            <i class="fa-solid fa-circle-check text-success fs-4 d-block mb-1"></i>
                            Hiện không có đơn vé nào chờ duyệt!
                        </div>
                    `;
                } else {
                    listEl.innerHTML = pendingList.slice(0, 8).map(b => {
                        const amtStr = Number(b.total_amount || 0).toLocaleString('vi-VN');
                        return `
                            <div class="notif-item p-3 small">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <code class="text-primary fw-bold">${escHtml(b.booking_code)}</code>
                                    <span class="text-danger fw-bold">${amtStr} đ</span>
                                </div>
                                <div class="text-dark fw-semibold text-truncate">${escHtml(b.customer_name)} • ${escHtml(b.movie_title)}</div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="text-muted" style="font-size: 0.72rem;">${escHtml(b.payment_method_label || b.payment_method)} • ${escHtml(fmtTimeShort(b.created_at))}</span>
                                    <button type="button" class="btn btn-success text-white btn-sm py-0 px-2 fw-bold" style="font-size: 0.72rem;"
                                            onclick="window.quickApproveOrder(${Number(b.id)}, '${escHtml(b.booking_code)}', '${escHtml(amtStr)}', this)">
                                        <i class="fa-solid fa-check me-1"></i>Đã nhận tiền
                                    </button>
                                </div>
                            </div>
                        `;
                    }).join('');
                }
            } catch (e) {}
        };

        // Khởi tạo danh sách ban đầu
        window.loadPendingNotifications(false);

        // 1 kết nối SSE duy nhất cho toàn bộ giao diện Admin & Manager
        if (typeof EventSource !== 'undefined') {
            const es = new EventSource('/admin/api/bookings/stream');
            es.onmessage = (evt) => {
                try {
                    const payload = JSON.parse(evt.data);
                    if (!payload || !payload.type || payload.type === 'connected') return;

                    if (payload.type === 'created' && payload.payment_status === 'pending') {
                        const bId = Number(payload.bookingId || 0);
                        if (!bId || !lastPendingIds.has(bId)) {
                            if (bId) lastPendingIds.add(bId);
                            ringBell();
                            playNotifChime();
                            showPendingOrderToast(payload);
                        }
                    }

                    window.loadPendingNotifications(false);
                    window.dispatchEvent(new CustomEvent('cinestar:booking-change', { detail: payload }));
                } catch (e) {}
            };
        }

        // Fallback đồng bộ mỗi 8 giây phòng khi kết nối SSE bị ngắt
        setInterval(() => window.loadPendingNotifications(true), 8000);
    })();
    </script>
    <% } %>
</body>
</html>
